# --- DATOS PRIVADOS (nunca versionar fondos) ---
data/external/
data/raw/
data/private/
!data/inputs/
!data/outputs/
!data/inputs/.gitkeep
!data/outputs/.gitkeep

data/inputs/*
!data/inputs/.gitkeep
!data/inputs/manifest_consejos_guerra/
!data/inputs/manifest_consejos_guerra/**

data/outputs/*
